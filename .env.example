# Copy this file to .env (which is gitignored) and fill in real values. Never commit real secrets.

# --- Unzer sandbox ---
# Given to you live during the technical interview — see assignment §8.
UNZER_PRIVATE_KEY=s-priv-xxxxxxxxxxxxxxxxxxxx

# Where Unzer redirects the customer after a Wero/3-DS round trip.
UNZER_RETURN_URL=http://localhost:8080/api/orders/return

# Local dev only: point this at your ngrok/localtunnel URL + /webhooks/unzer.
# e.g. https://a1b2c3d4.ngrok-free.app/webhooks/unzer
UNZER_WEBHOOK_URL=

# --- Database ---
# Port 5433, not Postgres's default 5432 — see docker-compose.yml (avoids clashing with a
# Postgres you might already have running locally on 5432).
DB_URL=jdbc:postgresql://localhost:5433/shop
DB_USER=shop
DB_PASSWORD=shop

PORT=8080
